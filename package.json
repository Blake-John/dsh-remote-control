{
  "name": "dsh-remote-control",
  "version": "2.0.0",
  "type": "module",
  "description": "Expose the Harness Web GUI to a phone behind one permanent password: own listener, password gate, per-device sessions, reverse proxy.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "npm run check:manifest && npm test",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blake-John/dsh-remote-control.git"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
