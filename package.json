{
  "name": "@local/dsh-remote-control",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Expose the Harness Web GUI to a phone behind one permanent password: own listener, password gate, per-device sessions, reverse proxy.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs/*.md",
    "tests/*.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
